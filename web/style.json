{
 "version": 8,
 "name": "NirmalDhara night print",
 "metadata": {
  "note": "Ground, water, main roads, railways and a few names, in the colours of web/tokens.css. tests/test_map_style.py fails if a colour here is not a token."
 },
 "sources": {
  "ofm": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "ground",
   "type": "background",
   "paint": {
    "background-color": "#0E1A2B"
   }
  },
  {
   "id": "green",
   "type": "fill",
   "source": "ofm",
   "source-layer": "landcover",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "wood",
      "grass",
      "wetland"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#122236",
    "fill-opacity": 0.6
   }
  },
  {
   "id": "park",
   "type": "fill",
   "source": "ofm",
   "source-layer": "park",
   "paint": {
    "fill-color": "#122236",
    "fill-opacity": 0.6
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "ofm",
   "source-layer": "water",
   "paint": {
    "fill-color": "#16304A",
    "fill-outline-color": "#2B3F5C"
   }
  },
  {
   "id": "stream",
   "type": "line",
   "source": "ofm",
   "source-layer": "waterway",
   "layout": {
    "line-cap": "round"
   },
   "paint": {
    "line-color": "#16304A",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     9,
     0.8,
     14,
     3
    ]
   }
  },
  {
   "id": "building",
   "type": "fill",
   "source": "ofm",
   "source-layer": "building",
   "minzoom": 14.5,
   "paint": {
    "fill-color": "#122236",
    "fill-opacity": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     14.5,
     0,
     16,
     0.7
    ]
   }
  },
  {
   "id": "road-minor",
   "type": "line",
   "source": "ofm",
   "source-layer": "transportation",
   "minzoom": 12,
   "filter": [
    "all",
    [
     "in",
     [
      "get",
      "class"
     ],
     [
      "literal",
      [
       "minor",
       "service",
       "tertiary"
      ]
     ]
    ],
    [
     "!=",
     [
      "get",
      "brunnel"
     ],
     "tunnel"
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#2B3F5C",
    "line-opacity": 0.45,
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     12,
     0.3,
     16,
     3
    ]
   }
  },
  {
   "id": "road-secondary",
   "type": "line",
   "source": "ofm",
   "source-layer": "transportation",
   "minzoom": 10,
   "filter": [
    "all",
    [
     "in",
     [
      "get",
      "class"
     ],
     [
      "literal",
      [
       "secondary"
      ]
     ]
    ],
    [
     "!=",
     [
      "get",
      "brunnel"
     ],
     "tunnel"
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#2B3F5C",
    "line-opacity": 0.7,
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     0.4,
     16,
     5
    ]
   }
  },
  {
   "id": "road-main",
   "type": "line",
   "source": "ofm",
   "source-layer": "transportation",
   "minzoom": 0,
   "filter": [
    "all",
    [
     "in",
     [
      "get",
      "class"
     ],
     [
      "literal",
      [
       "primary",
       "trunk"
      ]
     ]
    ],
    [
     "!=",
     [
      "get",
      "brunnel"
     ],
     "tunnel"
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#2B3F5C",
    "line-opacity": 0.9,
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     9,
     0.7,
     16,
     8
    ]
   }
  },
  {
   "id": "road-motorway",
   "type": "line",
   "source": "ofm",
   "source-layer": "transportation",
   "minzoom": 0,
   "filter": [
    "all",
    [
     "in",
     [
      "get",
      "class"
     ],
     [
      "literal",
      [
       "motorway"
      ]
     ]
    ],
    [
     "!=",
     [
      "get",
      "brunnel"
     ],
     "tunnel"
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#2B3F5C",
    "line-opacity": 1.0,
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     9,
     1.0,
     16,
     10
    ]
   }
  },
  {
   "id": "rail",
   "type": "line",
   "source": "ofm",
   "source-layer": "transportation",
   "minzoom": 0,
   "filter": [
    "all",
    [
     "in",
     [
      "get",
      "class"
     ],
     [
      "literal",
      [
       "rail"
      ]
     ]
    ],
    [
     "!=",
     [
      "get",
      "brunnel"
     ],
     "tunnel"
    ]
   ],
   "layout": {
    "line-cap": "butt",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#2B3F5C",
    "line-opacity": 0.9,
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     9,
     0.6,
     16,
     2
    ],
    "line-dasharray": [
     4,
     3
    ]
   }
  },
  {
   "id": "name-water",
   "type": "symbol",
   "source": "ofm",
   "source-layer": "water_name",
   "minzoom": 0,
   "maxzoom": 24,
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:en"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Italic"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     10,
     10,
     15,
     13
    ],
    "text-letter-spacing": 0.04,
    "text-max-width": 7,
    "text-padding": 12
   },
   "paint": {
    "text-color": "#A9B6C6",
    "text-opacity": 0.75,
    "text-halo-color": "#0E1A2B",
    "text-halo-width": 1.4
   }
  },
  {
   "id": "name-road",
   "type": "symbol",
   "source": "ofm",
   "source-layer": "transportation_name",
   "minzoom": 13.5,
   "maxzoom": 24,
   "layout": {
    "symbol-placement": "line",
    "text-field": [
     "coalesce",
     [
      "get",
      "name:en"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 11,
    "text-letter-spacing": 0.06
   },
   "paint": {
    "text-color": "#A9B6C6",
    "text-opacity": 0.6,
    "text-halo-color": "#0E1A2B",
    "text-halo-width": 1.4
   },
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "primary",
      "trunk",
      "motorway"
     ]
    ]
   ]
  },
  {
   "id": "name-area",
   "type": "symbol",
   "source": "ofm",
   "source-layer": "place",
   "minzoom": 11.2,
   "maxzoom": 24,
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:en"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     11,
     9.5,
     15,
     12
    ],
    "text-letter-spacing": 0.12,
    "text-max-width": 7,
    "text-padding": 12,
    "text-transform": "uppercase"
   },
   "paint": {
    "text-color": "#A9B6C6",
    "text-opacity": 0.8,
    "text-halo-color": "#0E1A2B",
    "text-halo-width": 1.4
   },
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "suburb",
      "neighbourhood",
      "quarter"
     ]
    ]
   ]
  },
  {
   "id": "name-town",
   "type": "symbol",
   "source": "ofm",
   "source-layer": "place",
   "minzoom": 9.5,
   "maxzoom": 13,
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:en"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 11,
    "text-letter-spacing": 0.12,
    "text-max-width": 7,
    "text-padding": 12,
    "text-transform": "uppercase"
   },
   "paint": {
    "text-color": "#A9B6C6",
    "text-opacity": 0.8,
    "text-halo-color": "#0E1A2B",
    "text-halo-width": 1.4
   },
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "town",
      "village"
     ]
    ]
   ]
  },
  {
   "id": "name-city",
   "type": "symbol",
   "source": "ofm",
   "source-layer": "place",
   "minzoom": 0,
   "maxzoom": 12.5,
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:en"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     9,
     13,
     12,
     17
    ],
    "text-letter-spacing": 0.3,
    "text-max-width": 7,
    "text-padding": 12,
    "text-transform": "uppercase"
   },
   "paint": {
    "text-color": "#F3EDE1",
    "text-opacity": 0.9,
    "text-halo-color": "#0E1A2B",
    "text-halo-width": 1.4
   },
   "filter": [
    "==",
    [
     "get",
     "class"
    ],
    "city"
   ]
  }
 ]
}
